# Copy to .env and replace every CHANGE_ME. .env is git-ignored: no credential enters the repository.
# `docker compose up` refuses to start while a required value is missing.

# --- Shared --------------------------------------------------------------------------------------

# Presented as X-Service-Token on every /api/v1/internal call. One value for the whole stack: a
# caller's token is compared against the callee's, so they must match.
SERVICE_TOKEN=CHANGE_ME

# MOCK_JWT_SECRET is retired: since Tamagotchi 2.1.0 and Notification 2.1.0 both verify RS256
# access tokens against User Management's published keys, so no shared signing secret exists.

# --- One password per database: each service owns its store and its own credentials -----------

USERMGMT_DB_PASSWORD=CHANGE_ME
TAMAGOTCHI_DB_PASSWORD=CHANGE_ME
REGISTRY_DB_PASSWORD=CHANGE_ME
BATTLE_DB_PASSWORD=CHANGE_ME
NOTIFICATION_DB_PASSWORD=CHANGE_ME
GUILD_DB_PASSWORD=CHANGE_ME
RAID_DB_PASSWORD=CHANGE_ME
MAP_REDIS_PASSWORD=CHANGE_ME
RAID_REDIS_PASSWORD=CHANGE_ME

# --- Dependency modes ---------------------------------------------------------------------------
# Every service except Guild starts with its calls to other services mocked; uncomment a line to
# switch that service to call its neighbours for real. Guild calls User Management for real by
# default; uncomment its line to mock it instead.

# BATTLE_DEPENDENCY_MODE=live
# GUILD_USER_MANAGEMENT_MODE=mock
# MAP_RELATIONSHIP_MODE=http
# RAID_DEPENDENCY_MODE=http
