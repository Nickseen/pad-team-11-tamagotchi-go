# Copy to .env and replace every CHANGE_ME. .env is git-ignored: no credential enters the repository.
# `docker compose up` refuses to start while a required value is missing.
# Generate each secret with: openssl rand -hex 32

# --- Shared --------------------------------------------------------------------------------------

# Sent by the Gateway to every service as X-Gateway-Token, proving that the identity headers it
# forwards come from the Gateway. At least 16 characters: the Gateway and the services refuse less.
GATEWAY_TOKEN=CHANGE_ME

# Presented as X-Service-Token on service calls and events through the Message Broker; gRPC uses
# x-service-token metadata. One value for Broker and callees. At least 16 characters.
SERVICE_TOKEN=CHANGE_ME

# --- One password per store: each service owns its store and its own credentials ---------------

USERMGMT_DB_PASSWORD=CHANGE_ME
TAMAGOTCHI_DB_PASSWORD=CHANGE_ME
REGISTRY_DB_PASSWORD=CHANGE_ME
BATTLE_DB_PASSWORD=CHANGE_ME
NOTIFICATION_DB_PASSWORD=CHANGE_ME
GUILD_DB_PASSWORD=CHANGE_ME
RAID_DB_PASSWORD=CHANGE_ME
MAP_REDIS_PASSWORD=CHANGE_ME
GUILD_REDIS_PASSWORD=CHANGE_ME
RAID_REDIS_PASSWORD=CHANGE_ME

# --- Replicas -----------------------------------------------------------------------------------
# User Management, Package Registry and Battle run under deploy.replicas (default 2). Discovery
# admits up to 5.

USER_MANAGEMENT_REPLICAS=2
PACKAGE_REGISTRY_REPLICAS=2
BATTLE_REPLICAS=2

# --- Dependency modes ---------------------------------------------------------------------------
# Map/Raid use gRPC through Broker by default. Battle uses live dependencies; Guild uses real
# user lookups with grpc transport. Existing .env overrides take precedence over Compose defaults.
# Keep these values for the Lab 4 rehearsal; use mock/http only for explicit local diagnosis.

BATTLE_DEPENDENCY_MODE=live
MAP_RELATIONSHIP_MODE=grpc
GUILD_USER_MANAGEMENT_MODE=real
RAID_DEPENDENCY_MODE=grpc

# --- Lab 3: Service Discovery alerts ---------------------------------------------------------
# Discovery sends critical-load and health alerts to the developers' Telegram chat. Create a bot
# with @BotFather and put its token and the chat ID here. ALERTS_ENABLED=false logs alerts instead
# of sending them, for a run without a bot.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ALERTS_ENABLED=false

# --- Monitoring (Lab 4, #154) --------------------------------------------------------------
# Grafana on http://localhost:3000 (anonymous viewers can look; admin logs in with this password).
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Replica origins, WebSocket ports and the Discovery allowlist are fixed in docker-compose.yml.
# The User Management signing key is the file secrets/jwt-signing-key.pem; see the README.
