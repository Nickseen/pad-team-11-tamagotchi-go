# Copy to .env and replace every CHANGE_ME. .env is git-ignored: no credential enters the repository.
# `docker compose up` refuses to start while a required value is missing.
# Generate each secret with: openssl rand -hex 32

# --- Shared --------------------------------------------------------------------------------------

# Sent by the Gateway to every service as X-Gateway-Token, proving that the identity headers it
# forwards come from the Gateway. At least 16 characters: the Gateway and the services refuse less.
GATEWAY_TOKEN=CHANGE_ME

# Presented as X-Service-Token on every service-to-service call through the Gateway. One value for
# the whole stack: the Gateway and the callee both compare it. At least 16 characters.
SERVICE_TOKEN=CHANGE_ME

# --- One password per store: each service owns its store and its own credentials ---------------

USERMGMT_DB_PASSWORD=CHANGE_ME
TAMAGOTCHI_DB_PASSWORD=CHANGE_ME
REGISTRY_DB_PASSWORD=CHANGE_ME
BATTLE_DB_PASSWORD=CHANGE_ME
NOTIFICATION_DB_PASSWORD=CHANGE_ME
GUILD_DB_PASSWORD=CHANGE_ME
RAID_DB_PASSWORD=CHANGE_ME
MAP_REDIS_PASSWORD=CHANGE_ME
GUILD_REDIS_PASSWORD=CHANGE_ME
RAID_REDIS_PASSWORD=CHANGE_ME

# --- Dependency modes ---------------------------------------------------------------------------
# Battle, Map and Guild call their neighbours for real through the Gateway; uncomment a line to mock
# them instead. Monster Raid starts mocked, because a real raid needs an admin-created raid
# definition and User Management issues no admin role; uncomment its line to call Guild, Package
# Registry and Tamagotchi for real.

# BATTLE_DEPENDENCY_MODE=mock
# MAP_RELATIONSHIP_MODE=mock
# GUILD_USER_MANAGEMENT_MODE=mock
# RAID_DEPENDENCY_MODE=http

# --- WebSocket addresses returned to clients ---------------------------------------------------
# The Gateway answers a WebSocket ticket request with a direct URL to Map, Guild or Monster Raid.
# The defaults suit a client on this machine; set them when clients connect from elsewhere.

# MAP_WS_PUBLIC_URL=ws://localhost:8085
# GUILD_WS_PUBLIC_URL=ws://localhost:8087
# MONSTER_RAID_WS_PUBLIC_URL=ws://localhost:8088
