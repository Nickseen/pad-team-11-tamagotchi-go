{
  "info": {
    "name": "Map Service (Lab 2, through Gateway)",
    "description": "Run in saved order against the Lab 2 stack. User Management registration and all REST requests go through Gateway. The map.stream ticket returns a direct WebSocket URL; open it separately in Postman and send a location.update frame. Do not commit a real service token or ticket.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup (User Management)",
      "description": "Create a test user and obtain a real RS256 access token from User Management.",
      "item": [
        {
          "name": "Register test user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/user-management/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{username}}@example.com\",\n  \"packageId\": \"{{packageId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created or 409 already registered', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in test user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/user-management/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('userToken', pm.response.json().accessToken);",
                  "const payload = JSON.parse(atob(pm.response.json().accessToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "pm.collectionVariables.set('userId', payload.sub);",
                  "pm.test('RS256 access token returned', () => pm.expect(pm.response.json().accessToken).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Gateway health",
      "item": [
        {
          "name": "Gateway health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/health",
            "description": "Gateway liveness. Service health is monitored by Compose."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Gateway returns 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Location flow",
      "description": "Run in order. The first request creates a fresh position and the final request deletes it.",
      "item": [
        {
          "name": "Update my location",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": {{latitude}},\n  \"longitude\": {{longitude}},\n  \"accuracyMeters\": {{accuracyMeters}},\n  \"recordedAt\": \"{{recordedAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gatewayUrl}}/map/api/v1/locations",
            "description": "Expected: 202, accepted=true. Generates a current UTC recordedAt value."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('recordedAt', new Date().toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 202', () => pm.response.to.have.status(202));",
                  "const json = pm.response.json();",
                  "pm.test('Position is accepted', () => pm.expect(json.accepted).to.eql(true));",
                  "pm.test('Expiry is returned', () => pm.expect(json.expiresAt).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Find nearby users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/map/api/v1/map/nearby?radiusMeters={{radiusMeters}}",
            "description": "Expected: 200 with an items array. With one local token the array is normally empty."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Items is an array', () => pm.expect(pm.response.json().items).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List visible related users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/map/api/v1/map/visible",
            "description": "Expected: 200 with an items array. The current empty relationship provider returns no users."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Items is an array', () => pm.expect(pm.response.json().items).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read position internally",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{serviceToken}}",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/map/api/v1/internal/positions/{{userId}}",
            "description": "Expected: 200. This service-context request uses X-Service-Token through Gateway, without a user bearer token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Correct user is returned', () => pm.expect(pm.response.json().userId).to.eql(pm.collectionVariables.get('userId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete my location",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/map/api/v1/locations/me",
            "description": "Expected: 204 with no response body."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Representative errors",
      "item": [
        {
          "name": "Reject missing bearer token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 47.0245,\n  \"longitude\": 28.8323,\n  \"accuracyMeters\": 8.5,\n  \"recordedAt\": \"{{recordedAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gatewayUrl}}/map/api/v1/locations",
            "description": "Expected: 401 UNAUTHORIZED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Error code is UNAUTHORIZED', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED'));",
                  "pm.test('Error envelope has correlationId', () => pm.expect(pm.response.json().correlationId).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid coordinates",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 91,\n  \"longitude\": 28.8323,\n  \"accuracyMeters\": 8.5,\n  \"recordedAt\": \"{{recordedAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gatewayUrl}}/map/api/v1/locations",
            "description": "Expected: 400 INVALID_COORDINATE."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('recordedAt', new Date().toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is INVALID_COORDINATE', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_COORDINATE'));",
                  "pm.test('Error envelope has correlationId', () => pm.expect(pm.response.json().correlationId).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject expired position",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 47.0245,\n  \"longitude\": 28.8323,\n  \"accuracyMeters\": 8.5,\n  \"recordedAt\": \"{{expiredRecordedAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gatewayUrl}}/map/api/v1/locations",
            "description": "Expected: 400 POSITION_ALREADY_EXPIRED."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('expiredRecordedAt', new Date(Date.now() - 10 * 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is POSITION_ALREADY_EXPIRED', () => pm.expect(pm.response.json().error.code).to.eql('POSITION_ALREADY_EXPIRED'));",
                  "pm.test('Error envelope has correlationId', () => pm.expect(pm.response.json().correlationId).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid radius",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/map/api/v1/map/nearby?radiusMeters=5001",
            "description": "Expected: 400 INVALID_RADIUS. Requires an active caller position; run Location flow through the update first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is INVALID_RADIUS', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_RADIUS'));",
                  "pm.test('Error envelope has correlationId', () => pm.expect(pm.response.json().correlationId).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid service token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "invalid-local-token",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/map/api/v1/internal/positions/{{userId}}",
            "description": "Expected: 401 UNAUTHORIZED for an invalid X-Service-Token through Gateway."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Error code is UNAUTHORIZED', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED'));",
                  "pm.test('Error envelope has correlationId', () => pm.expect(pm.response.json().correlationId).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Report missing position after deletion",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/map/api/v1/map/nearby?radiusMeters={{radiusMeters}}",
            "description": "Expected: 404 POSITION_EXPIRED when run after Delete my location."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Error code is POSITION_EXPIRED', () => pm.expect(pm.response.json().error.code).to.eql('POSITION_EXPIRED'));",
                  "pm.test('Error envelope has correlationId', () => pm.expect(pm.response.json().correlationId).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "403 - client cannot read internal position",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/map/api/v1/internal/positions/{{userId}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 INTERNAL_ROUTE_FORBIDDEN', () => pm.response.to.have.status(403));",
                  "pm.test('error code', () => pm.expect(pm.response.json().error.code).to.eql('INTERNAL_ROUTE_FORBIDDEN'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Map stream (Gateway ticket)",
      "item": [
        {
          "name": "Negotiate map.stream ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"channel\":\"map.stream\",\"resourceId\":null}"
            },
            "url": "{{gatewayUrl}}/api/v1/gateway/websocket-tickets",
            "description": "Gateway issues a short-lived ticket and direct service URL. Open websocketUrl as a WebSocket request in Postman; obtain a fresh ticket for reconnect."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('direct WebSocket URL', () => { pm.expect(json.url).to.match(/^wss?:\\/\\//); pm.expect(json.url).to.include('/api/v1/map/stream?ticket='); pm.expect(json.url).to.not.include('/monster-raid/api/'); pm.expect(json.url).to.not.include('/map/api/'); });",
                  "pm.test('ticket expires within 60 s', () => { const ttl = new Date(json.expiresAt).getTime() - Date.now(); pm.expect(ttl).to.be.within(-5000, 65000); });",
                  "pm.collectionVariables.set('mapStreamUrl', json.url);"
                ]
              }
            }
          ]
        },
        {
          "name": "400 - map.stream cannot name a resource",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{gatewayUrl}}/api/v1/gateway/websocket-tickets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"map.stream\",\n  \"resourceId\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 VALIDATION_FAILED', () => pm.response.to.have.status(400));",
                  "pm.test('error code', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_FAILED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "401 - ticket without access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/api/v1/gateway/websocket-tickets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"map.stream\",\n  \"resourceId\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 UNAUTHORIZED', () => pm.response.to.have.status(401));",
                  "pm.test('error code', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED'));"
                ]
              }
            }
          ]
        }
      ],
      "description": "The runner checks ticket negotiation. Open mapStreamUrl separately as a Postman WebSocket request and send a location.update frame with a current recordedAt. Request a fresh ticket for every reconnect; never log the ticket."
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('username')) pm.collectionVariables.set('username', 'map_' + pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').slice(0, 12));",
          "if (!pm.collectionVariables.get('password')) pm.collectionVariables.set('password', pm.variables.replaceIn('{{$guid}}') + 'Aa1!');"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "latitude",
      "value": "47.0245"
    },
    {
      "key": "longitude",
      "value": "28.8323"
    },
    {
      "key": "accuracyMeters",
      "value": "8.5"
    },
    {
      "key": "radiusMeters",
      "value": "500"
    },
    {
      "key": "recordedAt",
      "value": ""
    },
    {
      "key": "expiredRecordedAt",
      "value": ""
    },
    {
      "key": "mapStreamUrl",
      "value": ""
    }
  ]
}
