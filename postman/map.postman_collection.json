                  "pm.test('Error envelope has correlationId', () => pm.expect(pm.response.json().correlationId).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject expired position",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mapUserToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 47.0245,\n  \"longitude\": 28.8323,\n  \"accuracyMeters\": 8.5,\n  \"recordedAt\": \"{{mapExpiredRecordedAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{mapUrl}}/api/v1/locations",
              "host": [
                "{{mapUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "locations"
              ]
            },
            "description": "Expected: 400 POSITION_ALREADY_EXPIRED."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('mapExpiredRecordedAt', new Date(Date.now() - 10 * 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is POSITION_ALREADY_EXPIRED', () => pm.expect(pm.response.json().error.code).to.eql('POSITION_ALREADY_EXPIRED'));",
                  "pm.test('Error envelope has correlationId', () => pm.expect(pm.response.json().correlationId).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid radius",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{mapUserToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{mapUrl}}/api/v1/map/nearby?radiusMeters=5001",
              "host": [
                "{{mapUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "map",
                "nearby"
              ],
              "query": [
                {
                  "key": "radiusMeters",
                  "value": "5001"
                }
              ]
            },
            "description": "Expected: 400 INVALID_RADIUS. Requires an active caller position; run Location flow through the update first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
