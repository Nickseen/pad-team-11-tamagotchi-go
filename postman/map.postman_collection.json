              "raw": "{\n  \"latitude\": 91,\n  \"longitude\": 28.8323,\n  \"accuracyMeters\": 8.5,\n  \"recordedAt\": \"{{mapRecordedAt}}\"\n}",
              "options": {
                "raw": {
