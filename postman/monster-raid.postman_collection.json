                  "pm.test('Error envelope has correlationId', () => pm.expect(pm.response.json().correlationId).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid identifiers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guildId\": \"not-a-uuid\",\n  \"raidDefinitionId\": \"{{raidDefinitionId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{monsterRaidUrl}}/api/v1/raids",
              "host": [
                "{{monsterRaidUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "raids"
              ]
            },
            "description": "Expected: 400 INVALID_ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is INVALID_ID', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_ID'));",
                  "pm.test('Error envelope has correlationId', () => pm.expect(pm.response.json().correlationId).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject empty cancellation reason",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"   \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{monsterRaidUrl}}/api/v1/raids/{{exampleRaidId}}/cancel",
              "host": [
                "{{monsterRaidUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "raids",
                "{{exampleRaidId}}",
                "cancel"
              ]
            },
            "description": "Expected: 400 INVALID_REASON before raid lookup. Skipped when adminToken is unset because User Management does not issue admin tokens in the team stack."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const adminToken = pm.collectionVariables.get('adminToken'); if (!adminToken || adminToken === 'SET_TO_A_USER_MANAGEMENT_ADMIN_ACCESS_TOKEN') pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is INVALID_REASON', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_REASON'));",
                  "pm.test('Error envelope has correlationId', () => pm.expect(pm.response.json().correlationId).to.be.a('string'));"
                ]
              }
            }
          ]
        }
      ]
    }
