{
  "info": {
    "name": "Monster Raid Service (Lab 2, through Gateway)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in saved order against the Lab 2 stack. User Management registration and all REST requests go through Gateway. The raid lifecycle uses the configured mock Guild/Registry/Tamagotchi IDs unless real fixtures are provided. The raid.feed ticket returns a direct WebSocket URL; open it separately in Postman. Admin-only requests skip without a real admin JWT. Do not commit a real service token or ticket."
  },
  "item": [
    {
      "name": "Setup (User Management)",
      "description": "Create a test user and obtain a real RS256 access token from User Management.",
      "item": [
        {
          "name": "Register test user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/user-management/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{username}}@example.com\",\n  \"packageId\": \"{{packageId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created or 409 already registered', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in test user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/user-management/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('userToken', pm.response.json().accessToken);",
                  "const payload = JSON.parse(atob(pm.response.json().accessToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "pm.collectionVariables.set('userId', payload.sub);",
                  "pm.test('RS256 access token returned', () => pm.expect(pm.response.json().accessToken).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Gateway health",
      "item": [
        {
          "name": "Gateway health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/health",
            "description": "Gateway liveness. Service health is monitored by Compose."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Gateway returns 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Raid lifecycle (dependencies required)",
      "description": "Run in order with Guild, Registry, and Tamagotchi dependencies or mocks. Values must describe an owner/officer, an active definition, and that user’s primary Tamagotchi.",
      "item": [
        {
          "name": "Create raid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guildId\": \"{{guildId}}\",\n  \"raidDefinitionId\": \"{{raidDefinitionId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gatewayUrl}}/monster-raid/api/v1/raids",
            "description": "Expected: 201. Saves raidId for following requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Active raid is created', () => pm.expect(json.status).to.eql('active'));",
                  "pm.collectionVariables.set('raidId', json.raidId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get raid",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/monster-raid/api/v1/raids/{{raidId}}",
            "description": "Expected: 200 for the created raid."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Correct raid is returned', () => pm.expect(pm.response.json().raidId).to.eql(pm.collectionVariables.get('raidId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "List guild raids",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/monster-raid/api/v1/guilds/{{guildId}}/raids?status=active&limit=20",
            "description": "Expected: 200 collection envelope containing the created raid."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Collection envelope is returned', () => { pm.expect(json.items).to.be.an('array'); pm.expect(json.hasMore).to.be.a('boolean'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "403 - non-participant cannot get raid.feed ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{gatewayUrl}}/api/v1/gateway/websocket-tickets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"raid.feed\",\n  \"resourceId\": \"{{raidId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "The creator has not joined the raid yet."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 FORBIDDEN', () => pm.response.to.have.status(403));",
                  "pm.test('error code', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Join raid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"primaryTamagotchiId\": \"{{primaryTamagotchiId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gatewayUrl}}/monster-raid/api/v1/raids/{{raidId}}/participants",
            "description": "Expected: 201 with the pinned primary Tamagotchi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Primary Tamagotchi is pinned', () => pm.expect(pm.response.json().tamagotchiId).to.eql(pm.collectionVariables.get('primaryTamagotchiId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Internal - participant eligibility",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{serviceToken}}"
              }
            ],
            "url": "{{gatewayUrl}}/monster-raid/api/v1/internal/raids/{{raidId}}/participants/{{userId}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('current participant', () => pm.expect(pm.response.json().isParticipant).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Negotiate raid.feed ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"channel\":\"raid.feed\",\"resourceId\":\"{{raidId}}\"}"
            },
            "url": "{{gatewayUrl}}/api/v1/gateway/websocket-tickets",
            "description": "Open raidFeedUrl separately as a Postman WebSocket request. Expect raid.snapshot on connect; request a fresh ticket to reconnect."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('direct WebSocket URL', () => { pm.expect(json.url).to.match(/^wss?:\\/\\//); pm.expect(json.url).to.include('/api/v1/raids/'); pm.expect(json.url).to.not.include('/monster-raid/api/'); pm.expect(json.url).to.not.include('/map/api/'); });",
                  "pm.test('ticket expires within 60 s', () => { const ttl = new Date(json.expiresAt).getTime() - Date.now(); pm.expect(ttl).to.be.within(-5000, 65000); });",
                  "pm.collectionVariables.set('raidFeedUrl', json.url);",
                  "pm.test('URL matches raid', () => pm.expect(pm.response.json().url).to.include('/raids/' + pm.collectionVariables.get('raidId') + '/feed?ticket='));"
                ]
              }
            }
          ]
        },
        {
          "name": "List participants",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/monster-raid/api/v1/raids/{{raidId}}/participants?limit=20",
            "description": "Expected: 200 collection envelope."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Participant is listed', () => pm.expect(pm.response.json().items).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Attack raid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commandId\": \"{{commandId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gatewayUrl}}/monster-raid/api/v1/raids/{{raidId}}/attacks",
            "description": "Expected: 200. Generates commandId and stores the response for idempotency verification."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('commandId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Damage is applied', () => pm.expect(json.damageDealt).to.be.above(0));",
                  "pm.collectionVariables.set('attackSnapshot', JSON.stringify(json));"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay same attack command",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commandId\": \"{{commandId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gatewayUrl}}/monster-raid/api/v1/raids/{{raidId}}/attacks",
            "description": "Expected: 200 with exactly the original result and no second damage application."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const original = JSON.parse(pm.collectionVariables.get('attackSnapshot'));",
                  "const replay = pm.response.json();",
                  "pm.test('Idempotent response is unchanged', () => { pm.expect(replay.commandId).to.eql(original.commandId); pm.expect(replay.monsterHpRemaining).to.eql(original.monsterHpRemaining); pm.expect(replay.yourTotalDamage).to.eql(original.yourTotalDamage); pm.expect(replay.attackedAt).to.eql(original.attackedAt); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get leaderboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/monster-raid/api/v1/raids/{{raidId}}/leaderboard?limit=20",
            "description": "Expected: 200 with ranked damage entries."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Leaderboard has ranks', () => pm.expect(pm.response.json().items[0].rank).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Leave raid",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/monster-raid/api/v1/raids/{{raidId}}/participants/me",
            "description": "Expected: 204. Damage history remains stored."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Internal - former participant is ineligible",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{serviceToken}}"
              }
            ],
            "url": "{{gatewayUrl}}/monster-raid/api/v1/internal/raids/{{raidId}}/participants/{{userId}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('no longer a participant', () => pm.expect(pm.response.json().isParticipant).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rejoin raid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"primaryTamagotchiId\": \"{{primaryTamagotchiId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gatewayUrl}}/monster-raid/api/v1/raids/{{raidId}}/participants",
            "description": "Expected: 201 using the same pinned Tamagotchi; previous damage is retained."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Damage survives rejoin', () => pm.expect(pm.response.json().damageDealt).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel raid as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Postman state-transition check\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gatewayUrl}}/monster-raid/api/v1/raids/{{raidId}}/cancel",
            "description": "Expected: 200 and status=cancelled."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const adminToken = pm.collectionVariables.get('adminToken'); if (!adminToken || adminToken === 'SET_TO_A_USER_MANAGEMENT_ADMIN_ACCESS_TOKEN') pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Raid is cancelled', () => pm.expect(pm.response.json().status).to.eql('cancelled'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject attack after cancellation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commandId\": \"{{commandId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gatewayUrl}}/monster-raid/api/v1/raids/{{raidId}}/attacks",
            "description": "Expected: 409 RAID_NOT_ACTIVE."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const adminToken = pm.collectionVariables.get('adminToken'); if (!adminToken || adminToken === 'SET_TO_A_USER_MANAGEMENT_ADMIN_ACCESS_TOKEN') pm.execution.skipRequest();",
                  "pm.collectionVariables.set('commandId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('Error code is RAID_NOT_ACTIVE', () => pm.expect(pm.response.json().error.code).to.eql('RAID_NOT_ACTIVE'));",
                  "pm.test('Error envelope has correlationId', () => pm.expect(pm.response.json().correlationId).to.be.a('string'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Raid feed ticket errors",
      "description": "Gateway rejects invalid, absent and unauthorized ticket requests.",
      "item": [
        {
          "name": "400 - raid.feed needs a raidId",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{gatewayUrl}}/api/v1/gateway/websocket-tickets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"raid.feed\",\n  \"resourceId\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 VALIDATION_FAILED', () => pm.response.to.have.status(400));",
                  "pm.test('error code', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_FAILED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "401 - ticket without access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/api/v1/gateway/websocket-tickets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"raid.feed\",\n  \"resourceId\": \"{{raidId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 UNAUTHORIZED', () => pm.response.to.have.status(401));",
                  "pm.test('error code', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "403 - unknown raid is concealed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{gatewayUrl}}/api/v1/gateway/websocket-tickets",
            "body": {
              "mode": "raw",
