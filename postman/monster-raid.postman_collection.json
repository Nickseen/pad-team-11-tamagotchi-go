        {
          "name": "Cancel raid as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Postman state-transition check\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{monsterRaidUrl}}/api/v1/raids/{{raidId}}/cancel",
              "host": [
                "{{monsterRaidUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "raids",
                "{{raidId}}",
                "cancel"
              ]
            },
            "description": "Expected: 200 and status=cancelled. Skipped when adminToken is unset because User Management does not issue admin tokens in the team stack."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const adminToken = pm.collectionVariables.get('adminToken'); if (!adminToken || adminToken === 'SET_TO_A_USER_MANAGEMENT_ADMIN_ACCESS_TOKEN') pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Raid is cancelled', () => pm.expect(pm.response.json().status).to.eql('cancelled'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject attack after cancellation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commandId\": \"{{commandId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{monsterRaidUrl}}/api/v1/raids/{{raidId}}/attacks",
              "host": [
                "{{monsterRaidUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "raids",
                "{{raidId}}",
                "attacks"
              ]
            },
            "description": "Expected: 409 RAID_NOT_ACTIVE. Skipped when adminToken is unset because User Management does not issue admin tokens in the team stack."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const adminToken = pm.collectionVariables.get('adminToken'); if (!adminToken || adminToken === 'SET_TO_A_USER_MANAGEMENT_ADMIN_ACCESS_TOKEN') pm.execution.skipRequest();",
                  "pm.collectionVariables.set('commandId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('Error code is RAID_NOT_ACTIVE', () => pm.expect(pm.response.json().error.code).to.eql('RAID_NOT_ACTIVE'));",
                  "pm.test('Error envelope has correlationId', () => pm.expect(pm.response.json().correlationId).to.be.a('string'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Errors without dependencies",
      "description": "These requests are validated before any downstream call and can run with Monster Raid alone.",
      "item": [
        {
          "name": "Reject missing bearer token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guildId\": \"{{guildId}}\",\n  \"raidDefinitionId\": \"{{raidDefinitionId}}\"\n}",
