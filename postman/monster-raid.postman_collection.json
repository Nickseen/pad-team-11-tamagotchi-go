          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Damage survives rejoin', () => pm.expect(pm.response.json().damageDealt).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel raid as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{raidAdminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
