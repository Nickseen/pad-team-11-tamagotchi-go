{
  "info": {
    "_postman_id": "e0ae5ad6-4bcb-4c79-93c5-fcefe518ab89",
    "name": "Tamagotchi Go - Monster Raid Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Monster Raid API examples. Setup registers a User Management user and obtains an RS256 token. Lifecycle examples need Guild, Registry, and Tamagotchi fixtures. Admin-only requests and their cancellation-dependent assertion skip when no admin JWT is configured."
  },
  "item": [
    {
      "name": "Setup (User Management)",
      "description": "Create a test user and obtain a real RS256 access token from User Management.",
      "item": [
        {
          "name": "Register test user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userManagementUrl}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{username}}@example.com\",\n  \"packageId\": \"{{packageId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created or 409 already registered', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in test user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{userManagementUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('userToken', pm.response.json().accessToken);",
                  "const payload = JSON.parse(atob(pm.response.json().accessToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "pm.collectionVariables.set('userId', payload.sub);",
                  "pm.test('RS256 access token returned', () => pm.expect(pm.response.json().accessToken).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Health",
