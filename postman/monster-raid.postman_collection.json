              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Postman state-transition check\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{monsterRaidUrl}}/api/v1/raids/{{monsterRaidId}}/cancel",
              "host": [
                "{{monsterRaidUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "raids",
                "{{monsterRaidId}}",
                "cancel"
              ]
            },
            "description": "Expected: 200 and status=cancelled."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Raid is cancelled', () => pm.expect(pm.response.json().status).to.eql('cancelled'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject attack after cancellation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{raidUserToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commandId\": \"{{monsterRaidCommandId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{monsterRaidUrl}}/api/v1/raids/{{monsterRaidId}}/attacks",
              "host": [
                "{{monsterRaidUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "raids",
                "{{monsterRaidId}}",
                "attacks"
              ]
            },
            "description": "Expected: 409 RAID_NOT_ACTIVE."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('monsterRaidCommandId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('Error code is RAID_NOT_ACTIVE', () => pm.expect(pm.response.json().error.code).to.eql('RAID_NOT_ACTIVE'));",
                  "pm.test('Error envelope has correlationId', () => pm.expect(pm.response.json().correlationId).to.be.a('string'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Errors without dependencies",
      "description": "These requests are validated before any downstream call and can run with Monster Raid alone.",
      "item": [
        {
          "name": "Reject missing bearer token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guildId\": \"{{monsterRaidGuildId}}\",\n  \"raidDefinitionId\": \"{{monsterRaidDefinitionId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{monsterRaidUrl}}/api/v1/raids",
              "host": [
                "{{monsterRaidUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "raids"
              ]
            },
            "description": "Expected: 401 UNAUTHORIZED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Error code is UNAUTHORIZED', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED'));",
                  "pm.test('Error envelope has correlationId', () => pm.expect(pm.response.json().correlationId).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid identifiers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{raidUserToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guildId\": \"not-a-uuid\",\n  \"raidDefinitionId\": \"{{monsterRaidDefinitionId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{monsterRaidUrl}}/api/v1/raids",
              "host": [
                "{{monsterRaidUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "raids"
              ]
            },
            "description": "Expected: 400 INVALID_ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is INVALID_ID', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_ID'));",
                  "pm.test('Error envelope has correlationId', () => pm.expect(pm.response.json().correlationId).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
