{
  "info": {
    "_postman_id": "e0ae5ad6-4bcb-4c79-93c5-fcefe518ab89",
    "name": "Tamagotchi Go - Monster Raid Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Executable examples for every Monster Raid HTTP route. Health and dependency-independent errors run with the service alone. The lifecycle folder requires local Guild, Registry, and Tamagotchi services or their mocks."
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{monsterRaidUrl}}/healthz",
              "host": [
                "{{monsterRaidUrl}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "description": "Expected: 200 and {\"status\":\"ok\"}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Service is healthy', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Raid lifecycle (dependencies required)",
      "description": "Run in order with Guild, Registry, and Tamagotchi dependencies or mocks. Values must describe an owner/officer, an active definition, and that user’s primary Tamagotchi.",
      "item": [
        {
          "name": "Create raid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{raidUserToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guildId\": \"{{monsterRaidGuildId}}\",\n  \"raidDefinitionId\": \"{{monsterRaidDefinitionId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{monsterRaidUrl}}/api/v1/raids",
              "host": [
                "{{monsterRaidUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "raids"
              ]
            },
            "description": "Expected: 201. Saves raidId for following requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Active raid is created', () => pm.expect(json.status).to.eql('active'));",
                  "pm.environment.set('monsterRaidId', json.raidId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get raid",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{raidUserToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{monsterRaidUrl}}/api/v1/raids/{{monsterRaidId}}",
              "host": [
                "{{monsterRaidUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "raids",
                "{{monsterRaidId}}"
              ]
            },
            "description": "Expected: 200 for the created raid."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Correct raid is returned', () => pm.expect(pm.response.json().raidId).to.eql(pm.environment.get('monsterRaidId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "List guild raids",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{raidUserToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{monsterRaidUrl}}/api/v1/guilds/{{monsterRaidGuildId}}/raids?status=active&limit=20",
              "host": [
                "{{monsterRaidUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "guilds",
                "{{monsterRaidGuildId}}",
                "raids"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "active"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Expected: 200 collection envelope containing the created raid."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Collection envelope is returned', () => { pm.expect(json.items).to.be.an('array'); pm.expect(json.hasMore).to.be.a('boolean'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Join raid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{raidUserToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
