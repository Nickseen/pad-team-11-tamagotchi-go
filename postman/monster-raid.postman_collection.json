            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"primaryTamagotchiId\": \"{{monsterRaidPrimaryTamagotchiId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{monsterRaidUrl}}/api/v1/raids/{{monsterRaidId}}/participants",
              "host": [
                "{{monsterRaidUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "raids",
                "{{monsterRaidId}}",
                "participants"
              ]
            },
            "description": "Expected: 201 with the pinned primary Tamagotchi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Primary Tamagotchi is pinned', () => pm.expect(pm.response.json().tamagotchiId).to.eql(pm.environment.get('monsterRaidPrimaryTamagotchiId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "List participants",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{raidUserToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{monsterRaidUrl}}/api/v1/raids/{{monsterRaidId}}/participants?limit=20",
              "host": [
                "{{monsterRaidUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "raids",
                "{{monsterRaidId}}",
                "participants"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Expected: 200 collection envelope."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Participant is listed', () => pm.expect(pm.response.json().items).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Attack raid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{raidUserToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commandId\": \"{{monsterRaidCommandId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{monsterRaidUrl}}/api/v1/raids/{{monsterRaidId}}/attacks",
              "host": [
                "{{monsterRaidUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "raids",
                "{{monsterRaidId}}",
                "attacks"
              ]
            },
            "description": "Expected: 200. Generates commandId and stores the response for idempotency verification."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('monsterRaidCommandId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Damage is applied', () => pm.expect(json.damageDealt).to.be.above(0));",
                  "pm.environment.set('monsterRaidAttackSnapshot', JSON.stringify(json));"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay same attack command",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{raidUserToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commandId\": \"{{monsterRaidCommandId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{monsterRaidUrl}}/api/v1/raids/{{monsterRaidId}}/attacks",
              "host": [
                "{{monsterRaidUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "raids",
                "{{monsterRaidId}}",
                "attacks"
              ]
            },
            "description": "Expected: 200 with exactly the original result and no second damage application."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const original = JSON.parse(pm.environment.get('monsterRaidAttackSnapshot'));",
                  "const replay = pm.response.json();",
                  "pm.test('Idempotent response is unchanged', () => { pm.expect(replay.commandId).to.eql(original.commandId); pm.expect(replay.monsterHpRemaining).to.eql(original.monsterHpRemaining); pm.expect(replay.yourTotalDamage).to.eql(original.yourTotalDamage); pm.expect(replay.attackedAt).to.eql(original.attackedAt); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get leaderboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{raidUserToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{monsterRaidUrl}}/api/v1/raids/{{monsterRaidId}}/leaderboard?limit=20",
              "host": [
                "{{monsterRaidUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "raids",
                "{{monsterRaidId}}",
                "leaderboard"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Expected: 200 with ranked damage entries."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Leaderboard has ranks', () => pm.expect(pm.response.json().items[0].rank).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Leave raid",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{raidUserToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{monsterRaidUrl}}/api/v1/raids/{{monsterRaidId}}/participants/me",
              "host": [
                "{{monsterRaidUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "raids",
                "{{monsterRaidId}}",
                "participants",
                "me"
              ]
            },
            "description": "Expected: 204. Damage history remains stored."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rejoin raid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{raidUserToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"primaryTamagotchiId\": \"{{monsterRaidPrimaryTamagotchiId}}\"\n}",
