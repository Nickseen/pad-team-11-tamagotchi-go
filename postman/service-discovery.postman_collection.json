    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set('sdCorrelationId', pm.variables.replaceIn('{{$guid}}'));",
          "pm.variables.set('sdUnknownInstanceId', pm.variables.replaceIn('{{$guid}}'));",
          "pm.variables.set('sdUnknownAttemptId', pm.variables.replaceIn('{{$guid}}')); "
        ]
      }
