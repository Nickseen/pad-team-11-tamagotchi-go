                  "pm.test('common error envelope and correlation', () => { const payload = pm.response.json(); pm.expect(payload.correlationId).to.eql(pm.variables.get('sdCorrelationId')); pm.expect(payload.correlationId).to.eql(pm.response.headers.get('X-Correlation-Id')); pm.expect(Number.isNaN(Date.parse(payload.timestamp))).to.eql(false); pm.expect(payload.error).to.have.property('details'); });"
