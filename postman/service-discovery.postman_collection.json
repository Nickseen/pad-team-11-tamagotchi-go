  "item": [
    {
      "name": "Read-only checks",
      "item": [
        {
          "name": "Discovery status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{sdCorrelationId}}"
              }
            ],
            "url": "{{discoveryUrl}}/api/v1/status",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Discovery is ready', () => pm.response.to.have.status(200));",
                  "const payload = pm.response.json();",
                  "pm.test('SD status identity and version', () => { pm.expect(payload.service).to.eql('service-discovery'); pm.expect(payload.instanceId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/); pm.expect(payload.version).to.match(/^3\\.\\d+\\.\\d+$/); });",
                  "pm.test('local readiness and load are observable', () => { pm.expect(payload.live).to.eql(true); pm.expect(payload.ready).to.eql(true); pm.expect(Number.isInteger(payload.load.activeTasks)).to.eql(true); pm.expect(payload.load.activeTasks).to.be.at.least(0); pm.expect(Number.isInteger(payload.load.maxTasks)).to.eql(true); pm.expect(payload.load.maxTasks).to.be.above(0); pm.expect(payload.load.ratio).to.be.closeTo(payload.load.activeTasks / payload.load.maxTasks, 0.000001); pm.expect(Number.isNaN(Date.parse(payload.timestamp))).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Ready Map instances",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{serviceToken}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{sdCorrelationId}}"
              }
            ],
            "url": "{{discoveryUrl}}/api/v1/internal/discovery/services/map/instances",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('lookup succeeds', () => pm.response.to.have.status(200));",
                  "const payload = pm.response.json();",
                  "pm.test('lookup is a timestamped instance list', () => { pm.expect(payload.instances).to.be.an('array'); pm.expect(Number.isNaN(Date.parse(payload.generatedAt))).to.eql(false); });",
                  "pm.test('only ready unexpired map instances are exposed', () => { for (const instance of payload.instances) { pm.expect(instance.service).to.eql('map'); pm.expect(instance.state).to.eql('ready'); pm.expect(instance.instanceId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/); pm.expect(Date.parse(instance.leaseExpiresAt)).to.be.above(Date.parse(payload.generatedAt)); pm.expect(instance).to.not.have.property('serviceToken'); } });",
                  "pm.test('IDs are unique and sorted', () => { const ids = payload.instances.map(x => x.instanceId); pm.expect(ids).to.eql([...ids].sort()); pm.expect(new Set(ids).size).to.eql(ids.length); });"
                ]
              }
            }
          ]
        },
