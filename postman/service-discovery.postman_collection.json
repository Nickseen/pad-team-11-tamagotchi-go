            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service\": \"battle\",\n  \"instanceId\": \"{{sdFixtureInstanceId}}\",\n  \"attemptId\": \"{{sdFixtureAttemptId}}\",\n  \"endpoint\": \"GET /api/v1/battles/{battleId}\",\n  \"failure\": \"UPSTREAM_5XX\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
