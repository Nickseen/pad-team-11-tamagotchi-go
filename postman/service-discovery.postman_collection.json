        {
          "name": "First failed fixture attempt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{serviceToken}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{sdCorrelationId}}"
