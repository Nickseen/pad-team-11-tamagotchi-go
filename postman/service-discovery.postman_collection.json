    {
      "name": "Isolated fixture lifecycle (opt in)",
      "description": "Start a dedicated healthy battle status fixture at the explicitly allowlisted sdFixtureBaseUrl, with the fresh sdFixtureInstanceId. sdRunLifecycle defaults false. This folder registers only a newly owned ID, tests lease/dedup/three-error removal and cleans up that ID. It requires an otherwise idle isolated SD test process; do not run against the shared stack.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const enabled = String(pm.variables.get('sdRunLifecycle')) === 'true';",
              "if (!enabled) pm.execution.skipRequest();",
              "if (enabled) {",
              "  if (!/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/.test(String(pm.variables.get('sdFixtureInstanceId')))) throw new Error('Use a fresh UUID v4 for a dedicated fixture process');",
              "  if (!/^http:\\/\\/(sd-postman-fixture|127\\.0\\.0\\.1):\\d+$/.test(String(pm.variables.get('sdFixtureBaseUrl')))) throw new Error('Lifecycle requests require the isolated fixture origin');",
              "  if (pm.info.requestName !== 'Register isolated fixture' && (pm.collectionVariables.get('sdFixtureOwned') !== 'true' || pm.collectionVariables.get('sdFixtureOwnedId') !== pm.variables.get('sdFixtureInstanceId') || pm.collectionVariables.get('sdFixtureOwnedBaseUrl') !== pm.variables.get('sdFixtureBaseUrl'))) pm.execution.skipRequest();",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Register isolated fixture",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{serviceToken}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{sdCorrelationId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{discoveryUrl}}/api/v1/internal/discovery/instances",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service\": \"battle\",\n  \"instanceId\": \"{{sdFixtureInstanceId}}\",\n  \"baseUrl\": \"{{sdFixtureBaseUrl}}\",\n  \"statusPath\": \"/api/v1/status\",\n  \"version\": \"3.0.0\",\n  \"taskTimeoutMs\": 3000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('sdFixtureOwned', 'false');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('a new fixture ID is required', () => pm.response.to.have.status(201));",
                  "const payload = pm.response.json();",
                  "const owned = pm.response.code === 201 && payload.instanceId === pm.variables.get('sdFixtureInstanceId') && payload.baseUrl === pm.variables.get('sdFixtureBaseUrl');",
                  "pm.collectionVariables.set('sdFixtureOwned', owned ? 'true' : 'false');",
                  "pm.collectionVariables.set('sdFixtureOwnedId', owned ? payload.instanceId : '');",
                  "pm.collectionVariables.set('sdFixtureOwnedBaseUrl', owned ? payload.baseUrl : '');",
                  "pm.test('registration belongs to the configured fixture', () => pm.expect(owned).to.eql(true));",
                  "pm.test('registration starts pending', () => pm.expect(payload.state).to.eql('pending'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Repeat identical fixture registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Service-Token",
