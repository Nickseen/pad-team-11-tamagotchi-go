            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('lease is renewed', () => { pm.response.to.have.status(200); const payload = pm.response.json(); pm.expect(payload.instanceId).to.eql(pm.variables.get('sdFixtureInstanceId')); pm.expect(Date.parse(payload.leaseExpiresAt)).to.be.above(Date.parse(payload.registeredAt)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Wait for fixture readiness (bounded)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{serviceToken}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{sdCorrelationId}}"
              }
            ],
            "url": "{{discoveryUrl}}/api/v1/internal/discovery/services/battle/instances",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('initial lookup succeeds', () => pm.response.to.have.status(200));",
                  "const wanted = pm.variables.get('sdFixtureInstanceId');",
                  "const url = pm.variables.replaceIn('{{discoveryUrl}}/api/v1/internal/discovery/services/battle/instances');",
                  "let tries = 0;",
                  "function ready(response) {",
                  "  const found = response.json().instances.some(x => x.instanceId === wanted && x.state === 'ready');",
                  "  if (found || tries >= 20) { pm.test('the monitor makes the fixture ready', () => pm.expect(found).to.eql(true)); return; }",
                  "  tries++;",
                  "  setTimeout(() => pm.sendRequest({url, method:'GET', header:{'X-Service-Token':pm.variables.get('serviceToken'), 'X-Correlation-Id':pm.variables.replaceIn('{{$guid}}')}}, (error, next) => {",
                  "    if (error || !next || next.code !== 200) { pm.test('bounded readiness poll succeeds', () => { pm.expect(error).to.not.exist; pm.expect(next && next.code).to.eql(200); }); return; }",
                  "    ready(next);",
                  "  }), 250);",
                  "}",
                  "ready(pm.response);"
                ]
              }
            }
          ]
        },
        {
          "name": "409 - same ID cannot change its registration",
          "request": {
