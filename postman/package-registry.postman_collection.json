            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('version echoed', () => pm.expect(pm.response.json().version).to.eql(pm.collectionVariables.get('version')));"
                ]
