    {
      "name": "Packages & Versions",
      "item": [
        {
          "name": "Create package",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('moderatorIds has the caller', () => pm.expect(json.moderatorIds).to.include(pm.collectionVariables.get('moderatorId')));",
                  "pm.collectionVariables.set('registryPackageId', json.packageId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{moderatorToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"dragon-pack-{{runId}}\",\n  \"name\": \"Dragon Pack\",\n  \"description\": \"A Tamagotchi package with fire creatures\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{packageRegistryUrl}}/api/v1/packages"
          },
          "response": []
        },
        {
          "name": "List packages",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('created package is in the list', () => pm.expect(pm.response.json().items.map(p => p.packageId)).to.include(pm.collectionVariables.get('registryPackageId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{packageRegistryUrl}}/api/v1/packages?limit=100"
          },
          "response": []
        },
        {
