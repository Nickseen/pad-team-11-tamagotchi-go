            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('slug matches', () => pm.expect(pm.response.json().slug).to.eql('dragon-pack-' + pm.collectionVariables.get('runId')));"
                ]
