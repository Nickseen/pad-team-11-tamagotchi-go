{
  "info": {
    "name": "Package Registry Service",
    "description": "CRUD and lifecycle requests for the Package Registry service. Run top-to-bottom with the Collection Runner. Setup (User Management) registers and logs in two real users so every user-authenticated request carries a real RS256 token; internal routes send only X-Service-Token, no user token, per the CPR contract. Admin-only requests are skipped when no registryAdminToken is set, since User Management only issues the user role in Lab 1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "moderatorName",
      "value": ""
    },
    {
      "key": "otherName",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "runPackageId",
      "value": ""
    },
    {
      "key": "moderatorId",
      "value": ""
    },
    {
      "key": "otherId",
      "value": ""
    },
    {
      "key": "moderatorToken",
      "value": ""
    },
    {
      "key": "otherToken",
      "value": ""
    },
    {
      "key": "registryPackageId",
      "value": ""
    },
    {
      "key": "version",
      "value": "1.0.0"
    },
    {
      "key": "monsterId",
      "value": ""
    },
    {
      "key": "raidDefinitionId",
      "value": ""
    },
    {
      "key": "emptyPackageId",
      "value": ""
    },
    {
      "key": "registryAdminToken",
      "value": "",
      "type": "secret"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "    const runId = Date.now().toString(36);",
          "    pm.collectionVariables.set('runId', runId);",
          "    pm.collectionVariables.set('moderatorName', 'pad_pr_mod_' + runId);",
          "    pm.collectionVariables.set('otherName', 'pad_pr_other_' + runId);",
          "    pm.collectionVariables.set('password', 'postman-run-' + runId);",
          "    pm.collectionVariables.set('runPackageId', pm.variables.replaceIn('{{$guid}}'));",
          "}",
          "pm.request.headers.upsert({ key: 'X-Correlation-Id', value: pm.variables.replaceIn('{{$guid}}') });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Setup (User Management)",
      "item": [
        {
          "name": "Register the moderator",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('moderatorId', pm.response.json().userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{moderatorName}}\",\n  \"email\": \"{{moderatorName}}@example.com\",\n  \"password\": \"{{password}}\",\n  \"packageId\": \"{{runPackageId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{userManagementUrl}}/api/v1/auth/register"
          },
          "response": []
        },
        {
          "name": "Register the other user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('otherId', pm.response.json().userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{otherName}}\",\n  \"email\": \"{{otherName}}@example.com\",\n  \"password\": \"{{password}}\",\n  \"packageId\": \"{{runPackageId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{userManagementUrl}}/api/v1/auth/register"
          },
          "response": []
        },
        {
          "name": "Log in as the moderator",
