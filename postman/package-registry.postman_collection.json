        {
          "name": "List versions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('one version', () => pm.expect(pm.response.json().items).to.have.lengthOf(1));"
                ]
