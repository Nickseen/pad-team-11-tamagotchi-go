    {
      "name": "Guilds",
      "item": [
        {
          "name": "Create guild",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('ownerId matches the caller', () => pm.expect(json.ownerId).to.eql(pm.collectionVariables.get('ownerId')));",
                  "pm.test('memberCount starts at 1', () => pm.expect(json.memberCount).to.eql(1));",
                  "pm.collectionVariables.set('guildId', json.guildId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ember Wardens {{runId}}\",\n  \"tag\": \"E{{shortTag}}\",\n  \"description\": \"A guild for flame-type trainers\",\n  \"emblemRef\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{guildUrl}}/api/v1/guilds"
          },
          "response": []
        },
        {
          "name": "List guilds",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('the created guild is in the list', () => pm.expect(pm.response.json().items.map(g => g.guildId)).to.include(pm.collectionVariables.get('guildId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{guildUrl}}/api/v1/guilds?query={{runId}}",
              "host": [
                "{{guildUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "guilds"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "{{runId}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get guild",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('level starts at 1', () => pm.expect(pm.response.json().level).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{guildUrl}}/api/v1/guilds/{{guildId}}"
          },
          "response": []
