            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated guild description\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{guildUrl}}/api/v1/guilds/{{guildId}}"
          },
          "response": []
        },
        {
          "name": "Internal - get guild (service token only, for Monster Raid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
