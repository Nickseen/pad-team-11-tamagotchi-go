  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Mints throwaway RS256 tokens from scripts/dev_jwks_server.py if no",
          "// real ones were supplied via the environment (e.g. against a live",
          "// User Management). Requires: python scripts/dev_jwks_server.py",
          "const base = pm.collectionVariables.get('devJwksUrl');",
          "function mintIfMissing(varName, sub) {",
          "  if (pm.collectionVariables.get(varName)) return;",
          "  pm.sendRequest(`${base}/mint?sub=${sub}`, (err, res) => {",
          "    if (!err && res.code === 200) pm.collectionVariables.set(varName, res.json().token);",
          "  });",
          "}",
          "mintIfMissing('ownerToken', pm.collectionVariables.get('ownerUserId'));",
          "mintIfMissing('inviteeToken', pm.collectionVariables.get('inviteeUserId'));",
          "mintIfMissing('officerToken', pm.collectionVariables.get('officerUserId'));"
        ]
      }
    }
  ]
