{
  "info": {
    "name": "Guild Service",
    "description": "CRUD and lifecycle requests for the Guild service. Run top-to-bottom with the Collection Runner. Setup (User Management) registers and logs in two real users so every user-authenticated request carries a real RS256 token; internal routes send only X-Service-Token, no user token, per the CPR contract. The invitation flow exercises Guild's real call to User Management's bulk GET /api/v1/users?ids= route.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "ownerName",
      "value": ""
    },
    {
      "key": "inviteeName",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "runPackageId",
      "value": ""
    },
    {
      "key": "ownerId",
      "value": ""
    },
    {
      "key": "inviteeId",
      "value": ""
    },
    {
      "key": "ownerToken",
      "value": ""
    },
    {
      "key": "inviteeToken",
      "value": ""
    },
    {
      "key": "guildId",
      "value": ""
    },
    {
      "key": "invitationId",
      "value": ""
    },
    {
      "key": "declineInvitationId",
      "value": ""
    },
    {
      "key": "shortTag",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "    const runId = Date.now().toString(36);",
          "    pm.collectionVariables.set('runId', runId);",
          "    pm.collectionVariables.set('ownerName', 'pad_gd_own_' + runId);",
          "    pm.collectionVariables.set('inviteeName', 'pad_gd_inv_' + runId);",
          "    pm.collectionVariables.set('password', 'postman-run-' + runId);",
          "    pm.collectionVariables.set('runPackageId', pm.variables.replaceIn('{{$guid}}'));",
          "    pm.collectionVariables.set('shortTag', runId.slice(-4).toUpperCase());",
          "}",
          "pm.request.headers.upsert({ key: 'X-Correlation-Id', value: pm.variables.replaceIn('{{$guid}}') });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Setup (User Management)",
      "item": [
        {
          "name": "Register the owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('ownerId', pm.response.json().userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{ownerName}}\",\n  \"email\": \"{{ownerName}}@example.com\",\n  \"password\": \"{{password}}\",\n  \"packageId\": \"{{runPackageId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{userManagementUrl}}/api/v1/auth/register"
          },
          "response": []
        },
