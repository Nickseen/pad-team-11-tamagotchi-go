          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"the shortfall is reported, not refused\", () => pm.expect(pm.response.json().sufficient).to.be.false);"
                ]
              }
            }
          ]
        },
        {
          "name": "Debit more than the balance holds",
