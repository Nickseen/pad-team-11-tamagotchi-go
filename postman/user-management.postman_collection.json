            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"409 Conflict\", () => pm.response.to.have.status(409));",
                  "pm.test(\"INSUFFICIENT_FUNDS\", () => pm.expect(pm.response.json().error.code).to.eql(\"INSUFFICIENT_FUNDS\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Adjust a local balance without naming the package",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{serviceToken}}"
              }
            ],
            "url": "{{userManagementUrl}}/api/v1/internal/users/{{userAId}}/balances/adjust",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commandId\": \"{{commandId}}\",\n  \"currency\": \"local\",\n  \"packageId\": null,\n  \"delta\": 10,\n  \"reason\": \"package_reward\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('commandId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422 Unprocessable Entity\", () => pm.response.to.have.status(422));",
                  "pm.test(\"PACKAGE_REQUIRED\", () => pm.expect(pm.response.json().error.code).to.eql(\"PACKAGE_REQUIRED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Adjust an unknown currency",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{serviceToken}}"
              }
            ],
            "url": "{{userManagementUrl}}/api/v1/internal/users/{{userAId}}/balances/adjust",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commandId\": \"{{commandId}}\",\n  \"currency\": \"doubloons\",\n  \"packageId\": null,\n  \"delta\": 10,\n  \"reason\": \"typo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('commandId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422 Unprocessable Entity\", () => pm.response.to.have.status(422));",
                  "pm.test(\"UNKNOWN_CURRENCY\", () => pm.expect(pm.response.json().error.code).to.eql(\"UNKNOWN_CURRENCY\"));"
                ]
              }
            }
          ]
        }
      ]
