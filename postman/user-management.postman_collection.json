                ]
              }
            }
          ]
        },
        {
          "name": "Credit a battle reward",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{serviceToken}}"
              }
            ],
            "url": "{{userManagementUrl}}/api/v1/internal/users/{{userAId}}/balances/adjust",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commandId\": \"{{commandId}}\",\n  \"currency\": \"global\",\n  \"packageId\": null,\n  \"delta\": 250,\n  \"reason\": \"battle_reward\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "The Battle Service never writes a balance; it reports the outcome and this route applies it."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('commandId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"the balance is credited\", () => pm.expect(pm.response.json().globalCurrency).to.eql(250));"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay the same commandId",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{serviceToken}}"
              }
            ],
            "url": "{{userManagementUrl}}/api/v1/internal/users/{{userAId}}/balances/adjust",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commandId\": \"{{commandId}}\",\n  \"currency\": \"global\",\n  \"packageId\": null,\n  \"delta\": 250,\n  \"reason\": \"battle_reward\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"a redelivered command pays out once\", () => pm.expect(pm.response.json().globalCurrency).to.eql(250));"
                ]
              }
            }
          ]
        },
        {
          "name": "Check whether the balance covers an amount",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Service-Token",
                "value": "{{serviceToken}}"
              }
            ],
