              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('notificationId', pm.response.json().items[0].notificationId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark one as read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/notifications/{{notificationId}}/read"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"read\", () => pm.expect(pm.response.json().status === 'read').to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark all as read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/notifications/read-all"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"the raid notification was unread\", () => pm.expect(pm.response.json().updated >= 1).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Error: unknown notification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/notifications/00000000-0000-4000-8000-000000000000/read"
          },
          "event": [
