{
  "info": {
    "name": "Notification Service",
    "description": "Every route of the Notification service (Lab 1), in the order the Runner should run them. Tokens are signed from the environment's mockJwtSecret, which must equal the service's MOCK_JWT_SECRET.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "usernameA",
      "value": "postman-user-a"
    },
    {
      "key": "usernameB",
      "value": "postman-user-b"
    },
    {
      "key": "password",
      "value": "postman-test-password"
    },
    {
      "key": "tokenA",
      "value": ""
    },
    {
      "key": "tokenB",
      "value": ""
    },
    {
      "key": "userAId",
      "value": ""
    },
    {
      "key": "userBId",
      "value": ""
    },
    {
      "key": "fcmTokenA",
      "value": ""
    },
    {
      "key": "fcmTokenB",
      "value": ""
    },
    {
      "key": "deadToken",
      "value": ""
    },
    {
      "key": "deviceId",
      "value": ""
    },
    {
      "key": "deadDeviceId",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "battleId",
      "value": ""
    },
    {
      "key": "raidId",
      "value": ""
    },
    {
      "key": "correlationId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Setup (User Management)",
      "description": "Tokens come from User Management; nothing is signed locally.",
      "item": [
        {
          "name": "Register user A",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{userManagementUrl}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usernameA}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"postman-a@example.com\",\n  \"packageId\": \"{{packageId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created or 409 already registered\", () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as user A",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{userManagementUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usernameA}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenA', pm.response.json().accessToken);",
                  "pm.collectionVariables.set('userAId', pm.response.json().userId);",
                  "pm.test(\"an access token was returned\", () => pm.expect(pm.response.json().tokenType).to.eql(\"Bearer\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register user B",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{userManagementUrl}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usernameB}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"postman-b@example.com\",\n  \"packageId\": \"{{packageId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created or 409 already registered\", () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as user B",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{userManagementUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usernameB}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenB', pm.response.json().accessToken);",
                  "pm.collectionVariables.set('userBId', pm.response.json().userId);",
                  "pm.test(\"an access token was returned\", () => pm.expect(pm.response.json().tokenType).to.eql(\"Bearer\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Devices",
      "description": "FCM token registration.",
      "item": [
        {
          "name": "Register a device (user A)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/devices",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcmToken\": \"{{fcmTokenA}}\",\n  \"platform\": \"android\",\n  \"locale\": \"ro-MD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('fcmTokenA', 'postman-' + require('uuid').v4());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('deviceId', pm.response.json().deviceId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register the same token again",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/devices",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcmToken\": \"{{fcmTokenA}}\",\n  \"platform\": \"android\",\n  \"locale\": \"en-US\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK (already registered)\", () => pm.response.to.have.status(200));",
                  "pm.test(\"same device\", () => pm.expect(pm.response.json().deviceId === pm.collectionVariables.get('deviceId')).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register a device Firebase no longer knows (user A)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/devices",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcmToken\": \"{{deadToken}}\",\n  \"platform\": \"ios\",\n  \"locale\": \"ro-MD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('deadToken', 'unregistered-' + require('uuid').v4());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('deadDeviceId', pm.response.json().deviceId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register a device (user B)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenB}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/devices",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcmToken\": \"{{fcmTokenB}}\",\n  \"platform\": \"web\",\n  \"locale\": \"en-US\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('fcmTokenB', 'postman-' + require('uuid').v4());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "List user A's devices",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/devices"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Error: unknown platform",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/devices",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcmToken\": \"x\",\n  \"platform\": \"windows\",\n  \"locale\": \"ro-MD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422 UNSUPPORTED_VALUE\", () => {",
                  "    pm.response.to.have.status(422);",
                  "    pm.expect(pm.response.json().error.code).to.eql('UNSUPPORTED_VALUE');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Error: malformed locale",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/devices",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcmToken\": \"x\",\n  \"platform\": \"web\",\n  \"locale\": \"!!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 VALIDATION_FAILED\", () => {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().error.code).to.eql('VALIDATION_FAILED');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Preferences",
      "description": "Per-category push and quiet hours.",
      "item": [
        {
          "name": "Get preferences (all categories)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/notifications/preferences"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"eight categories\", () => pm.expect(pm.response.json().items.length === 8).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "User B turns off battle-result pushes",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenB}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/notifications/preferences",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"category\": \"battle_result\",\n      \"push\": false\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Error: quiet hour 25:00",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/notifications/preferences",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"category\": \"raid_started\",\n      \"push\": true,\n      \"quietHours\": {\n        \"from\": \"25:00\",\n        \"to\": \"08:00\"\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 VALIDATION_FAILED\", () => {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().error.code).to.eql('VALIDATION_FAILED');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Events (mock of RabbitMQ)",
      "description": "Events other services would publish, delivered by hand.",
      "item": [
        {
          "name": "battle.finished: user A beats user B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "X-Service-Token",
                "value": "{{serviceToken}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/internal/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventType\": \"battle.finished\",\n  \"eventVersion\": 1,\n  \"occurredAt\": \"2026-09-22T12:00:00.000Z\",\n  \"producer\": \"postman\",\n  \"correlationId\": \"{{correlationId}}\",\n  \"idempotencyKey\": \"{{idempotencyKey}}\",\n  \"payload\": {\n    \"battleId\": \"{{battleId}}\",\n    \"winnerId\": \"{{userAId}}\",\n    \"loserId\": \"{{userBId}}\",\n    \"outcome\": \"knockout\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('eventId', require('uuid').v4());",
                  "pm.collectionVariables.set('battleId', require('uuid').v4());",
                  "pm.collectionVariables.set('correlationId', require('uuid').v4());",
                  "pm.collectionVariables.set('idempotencyKey', require('uuid').v4());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"applied\", () => pm.expect(pm.response.json().status === 'applied').to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "The winner was notified and pushed",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/notifications?category=battle_result"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"sent\", () => pm.expect(pm.response.json().items[0].status === 'sent').to.be.true);",
                  "pm.test(\"winner's text\", () => pm.expect(pm.response.json().items[0].body === 'You won the battle!').to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "The loser has push off: stored, not pushed",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenB}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/notifications?category=battle_result"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"queued\", () => pm.expect(pm.response.json().items[0].status === 'queued').to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "The unregistered device was deleted",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/devices"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"dead device gone\", () => pm.expect(!pm.response.json().items.some(d => d.deviceId === pm.collectionVariables.get('deadDeviceId'))).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "The same event redelivered",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "X-Service-Token",
                "value": "{{serviceToken}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/internal/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventType\": \"battle.finished\",\n  \"eventVersion\": 1,\n  \"occurredAt\": \"2026-09-22T12:00:00.000Z\",\n  \"producer\": \"postman\",\n  \"correlationId\": \"{{correlationId}}\",\n  \"idempotencyKey\": \"{{idempotencyKey}}\",\n  \"payload\": {\n    \"battleId\": \"{{battleId}}\",\n    \"winnerId\": \"{{userAId}}\",\n    \"loserId\": \"{{userBId}}\",\n    \"outcome\": \"knockout\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"duplicate\", () => pm.expect(pm.response.json().status === 'duplicate').to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "An event with no notification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "X-Service-Token",
                "value": "{{serviceToken}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/internal/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventType\": \"user.registered\",\n  \"eventVersion\": 1,\n  \"occurredAt\": \"2026-09-22T12:00:00.000Z\",\n  \"producer\": \"postman\",\n  \"correlationId\": \"{{correlationId}}\",\n  \"idempotencyKey\": \"{{idempotencyKey}}\",\n  \"payload\": {\n    \"userId\": \"{{userAId}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('eventId', require('uuid').v4());",
                  "pm.collectionVariables.set('correlationId', require('uuid').v4());",
                  "pm.collectionVariables.set('idempotencyKey', require('uuid').v4());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ignored\", () => pm.expect(pm.response.json().status === 'ignored').to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "raid.started: every guild member is notified",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "X-Service-Token",
                "value": "{{serviceToken}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/internal/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventType\": \"raid.started\",\n  \"eventVersion\": 1,\n  \"occurredAt\": \"2026-09-22T12:00:00.000Z\",\n  \"producer\": \"postman\",\n  \"correlationId\": \"{{correlationId}}\",\n  \"idempotencyKey\": \"{{idempotencyKey}}\",\n  \"payload\": {\n    \"raidId\": \"{{raidId}}\",\n    \"guildId\": \"{{raidId}}\",\n    \"monsterId\": \"{{raidId}}\",\n    \"expiresAt\": \"2026-09-22T13:00:00.000Z\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('eventId', require('uuid').v4());",
                  "pm.collectionVariables.set('raidId', require('uuid').v4());",
                  "pm.collectionVariables.set('correlationId', require('uuid').v4());",
                  "pm.collectionVariables.set('idempotencyKey', require('uuid').v4());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"applied\", () => pm.expect(pm.response.json().status === 'applied').to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Error: event version this service does not understand",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              },
              {
                "key": "X-Service-Token",
                "value": "{{serviceToken}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/internal/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventType\": \"battle.finished\",\n  \"eventVersion\": 2,\n  \"occurredAt\": \"2026-09-22T12:00:00.000Z\",\n  \"producer\": \"postman\",\n  \"correlationId\": \"{{correlationId}}\",\n  \"idempotencyKey\": \"{{idempotencyKey}}\",\n  \"payload\": {\n    \"battleId\": \"{{battleId}}\",\n    \"winnerId\": \"{{userAId}}\",\n    \"loserId\": \"{{userBId}}\",\n    \"outcome\": \"knockout\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('eventId', require('uuid').v4());",
                  "pm.collectionVariables.set('correlationId', require('uuid').v4());",
                  "pm.collectionVariables.set('idempotencyKey', require('uuid').v4());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422 UNSUPPORTED_EVENT_VERSION\", () => {",
                  "    pm.response.to.have.status(422);",
                  "    pm.expect(pm.response.json().error.code).to.eql('UNSUPPORTED_EVENT_VERSION');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Error: event without X-Service-Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/internal/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventType\": \"battle.finished\",\n  \"eventVersion\": 1,\n  \"occurredAt\": \"2026-09-22T12:00:00.000Z\",\n  \"producer\": \"postman\",\n  \"correlationId\": \"{{correlationId}}\",\n  \"idempotencyKey\": \"{{idempotencyKey}}\",\n  \"payload\": {\n    \"battleId\": \"{{battleId}}\",\n    \"winnerId\": \"{{userAId}}\",\n    \"loserId\": \"{{userBId}}\",\n    \"outcome\": \"knockout\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 UNAUTHORIZED\", () => {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
