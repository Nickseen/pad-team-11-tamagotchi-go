          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{notificationUrl}}/api/v1/notifications?category=battle_result&limit=5"
          },
          "event": [
