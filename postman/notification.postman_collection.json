              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 NOTIFICATION_NOT_FOUND\", () => {",
                  "    pm.response.to.have.status(404);",
                  "    pm.expect(pm.response.json().error.code).to.eql('NOTIFICATION_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        }
