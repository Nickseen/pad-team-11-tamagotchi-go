              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('notificationId', pm.response.json().items[0].notificationId);"
                ]
              }
            }
          ]
        },
        {
