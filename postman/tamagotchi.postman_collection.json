      "value": ""
    },
    {
      "key": "secondaryCommandId",
      "value": ""
    },
    {
      "key": "referenceId",
      "value": ""
    },
    {
      "key": "xpCommandId",
      "value": ""
    },
    {
      "key": "transferCommandId",
      "value": ""
    },
    {
      "key": "transferBattleId",
      "value": ""
