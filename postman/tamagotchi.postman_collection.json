              "raw": "{\n  \"packageId\": \"{{packageId}}\",\n  \"name\": \"Sparky\",\n  \"combatType\": \"flame\",\n  \"spriteRef\": \"sprites/sparky.png\",\n  \"stats\": {\n    \"hunger\": 5,\n    \"energy\": 7.5\n  }\n}",
              "options": {
