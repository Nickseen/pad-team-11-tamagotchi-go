{
  "info": {
    "name": "Tamagotchi Service",
    "description": "Every route of the Tamagotchi service (Lab 1), in the order the Runner should run them. Tokens are signed from the environment's mockJwtSecret, which must equal the service's MOCK_JWT_SECRET.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Signs fresh test tokens the way the mocked User Management does: HS256 with MOCK_JWT_SECRET.",
          "// Wrapped in its own scope so its names cannot clash with the sandbox's globals.",
          "(() => {",
          "    const cryptoJs = require('crypto-js');",
          "    const base64url = words => cryptoJs.enc.Base64.stringify(words).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "    const encode = object => base64url(cryptoJs.enc.Utf8.parse(JSON.stringify(object)));",
          "    const sign = userId => {",
          "        const now = Math.floor(Date.now() / 1000);",
          "        const unsigned = encode({ alg: 'HS256', typ: 'JWT' }) + '.' +",
          "            encode({ sub: userId, iss: 'user-management', aud: 'tamagotchi-go', iat: now, exp: now + 3600 });",
          "        return unsigned + '.' + base64url(cryptoJs.HmacSHA256(unsigned, pm.environment.get('mockJwtSecret')));",
          "    };",
          "    pm.variables.set('tokenA', sign(pm.environment.get('userA')));",
          "    pm.variables.set('tokenB', sign(pm.environment.get('userB')));",
          "})();"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "tamagotchiId",
      "value": ""
    },
    {
      "key": "secondTamagotchiId",
      "value": ""
    },
    {
      "key": "opponentTamagotchiId",
      "value": ""
